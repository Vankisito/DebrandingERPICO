<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_hide_connect_software" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[button[@id='portal_connect_software_modal_btn']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='sale_portal_connect_software_modal']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template id="purchase_hide_connect_software" inherit_id="purchase.portal_my_purchase_order">
        <xpath expr="//div[button[@id='portal_connect_software_modal_btn']]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='portal_connect_software_modal']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>