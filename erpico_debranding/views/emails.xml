<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout_powered_by" inherit_id="mail.mail_notification_layout">
        <xpath expr="//a[contains(@href,'utm_medium=email')]" position="replace">
            <b>ERPICO</b>
        </xpath>
    </template>

    <template id="mail_notification_light_powered_by" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href,'utm_medium=email')]" position="replace">
            <b>ERPICO</b>
        </xpath>
    </template>

    <template id="reset_password_email_powered_by" inherit_id="auth_signup.reset_password_email">
        <xpath expr="//a[contains(@href,'utm_medium=auth')]" position="replace">
            <b>ERPICO</b>
        </xpath>
    </template>
</odoo>